<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"   
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"             
    xmlns:local="clr-namespace:S100Framework.WPF"
    xmlns:localcontrols="clr-namespace:S100Framework.WPF.Controls"
    xmlns:converters="clr-namespace:S100Framework.WPF.Converters">
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <converters:EnumSourceConverter x:Key="EnumSourceConverter"/>
    <converters:SelectedObjectSourceConverter x:Key="SelectedObjectSourceConverter"/>

    <!-- Template for Strings -->
    <DataTemplate x:Key="StringEditorTemplate">
        <TextBox Text="{Binding value, UpdateSourceTrigger=PropertyChanged}"/>
    </DataTemplate>

    <!-- Template for Integers -->
    <DataTemplate x:Key="IntegerEditorTemplate">
        <TextBox Text="{Binding value, UpdateSourceTrigger=PropertyChanged}"/>
    </DataTemplate>

    <!-- Template for Decimals -->
    <DataTemplate x:Key="DecimalEditorTemplate">
        <TextBox Text="{Binding value, UpdateSourceTrigger=PropertyChanged}"/>
    </DataTemplate>

    <!-- Template for Booleans -->
    <DataTemplate x:Key="BooleanEditorTemplate">
        <CheckBox IsChecked="{Binding value, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" IsThreeState="True"/>
    </DataTemplate>

    <DataTemplate x:Key="EnumEditorTemplate">
        <ComboBox ItemsSource="{Binding {}, Converter={StaticResource EnumSourceConverter}}" 
              DisplayMemberPath="label"
              SelectedValue="{Binding value, UpdateSourceTrigger=PropertyChanged}"
              SelectedValuePath="code"
              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}"                     
              Padding="2"/>
    </DataTemplate>

    <!--<DataTemplate x:Key="ComplexEditorTemplate">
    <local:S100AttributeEditor SelectedObject="{Binding {}, Converter={StaticResource SelectedObjectSourceConverter}}" />
</DataTemplate>-->

    <local:PropertyTemplateSelector x:Key="PropSelector" 
                                StringEditorTemplate="{StaticResource StringEditorTemplate}"
                                BooleanEditorTemplate="{StaticResource BooleanEditorTemplate}"
                                IntegerEditorTemplate="{StaticResource IntegerEditorTemplate}"
                                EnumEditorTemplate="{StaticResource EnumEditorTemplate}"/>
    <!--ComplexEditorTemplate="{StaticResource ComplexEditorTemplate}"/>-->

    <DataTemplate x:Key="DefaultItemControlTemplate">
        <Border BorderBrush="#F0EEF1" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- SharedSizeGroup="LabelColumn" is the magic part -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding code}" Margin="5" VerticalAlignment="Center"/>

                <ContentPresenter Grid.Column="1" 
                              Content="{Binding}" 
                              ContentTemplateSelector="{StaticResource PropSelector}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <HierarchicalDataTemplate x:Key="ComplexItemControlTemplate">
        <local:PropertyGrid SelectedObject="{Binding {}, Converter={StaticResource SelectedObjectSourceConverter}}" Padding="5,0,0,0"/>
    </HierarchicalDataTemplate>

    <local:ItemsControlTemplateSelector x:Key="ItemControlSelector" 
                                DefaultItemControlTemplate="{StaticResource DefaultItemControlTemplate}"
                                ComplexItemControlTemplate="{StaticResource ComplexItemControlTemplate}"/>

    <Style TargetType="{x:Type localcontrols:DropdownButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type localcontrols:DropdownButton}">
                    <Grid>
                        <!-- Main button -->
                        <ToggleButton x:Name="PART_Button" Content="{TemplateBinding Content}" IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="#EEE" BorderBrush="#888" BorderThickness="1" Padding="6,3" HorizontalContentAlignment="Left"/>
                        <!-- Popup -->
                        <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" PlacementTarget="{Binding ElementName=PART_Button}">
                            <Border Background="White" BorderBrush="#888" BorderThickness="1" CornerRadius="3" Padding="4">
                                <ContentPresenter Content="{TemplateBinding DropdownContent}"/>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonLikeComboBox" TargetType="ComboBox">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- MAIN BUTTON SURFACE -->
                        <ToggleButton
                x:Name="ToggleButton"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="{TemplateBinding BorderThickness}"
                Focusable="False"
                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                ClickMode="Press">
                            <Grid Width="18" Height="18">
                                <Path Fill="#4CAF50" Data="M9,0 A9,9 0 1 1 9,18 A9,9 0 1 1 9,0 Z" />
                                <Path Fill="White" Data="M8,4 H10 V8 H14 V10 H10 V14 H8 V10 H4 V8 H8 Z" />
                            </Grid>
                        </ToggleButton>

                        <Popup
                x:Name="Popup"
                Placement="Bottom"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                PopupAnimation="Slide">

                            <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- VISUAL STATES -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ToggleButton" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
