<UserControl x:Class="S100Framework.WPF.PropertyGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:S100Framework.WPF.Converters"
             xmlns:local="clr-namespace:S100Framework.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:ItemsControlTemplateSelector x:Key="ItemControlSelector"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Background="#F0EEF1">
            <ComboBox DockPanel.Dock="Right" 
                             ItemsSource="{Binding AttributeBindings, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" 
                             DisplayMemberPath="attribute"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}" FontWeight="Bold" />
        </DockPanel>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding PropertyValues, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}"
                      ItemTemplateSelector="{StaticResource ItemControlSelector}"/>
    </Grid>

</UserControl>
