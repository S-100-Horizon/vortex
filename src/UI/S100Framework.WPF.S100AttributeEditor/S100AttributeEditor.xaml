<UserControl x:Class="S100Framework.WPF.S100AttributeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:S100Framework.WPF"
             xmlns:localcontrols="clr-namespace:S100Framework.WPF.Controls"
             xmlns:viewmodel="clr-namespace:S100Framework.WPF.ViewModel;assembly=S100Framework.WPF"
             xmlns:converters="clr-namespace:S100Framework.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/S100Framework.WPF.S100AttributeEditor;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:ColumnWidthConverter x:Key="ColumnWidthConverter"/>
            <converters:PercentageConverter x:Key="PercentageConverter"/>

            <DataTemplate DataType="{x:Type viewmodel:SimpleAttributeViewModel}">
                <Border BorderBrush="#F0EEF1" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True" Background="Transparent">
                        <DockPanel DockPanel.Dock="Right" LastChildFill="True" Background="Transparent" 
                               Width="{Binding Converter={StaticResource PercentageConverter}, ElementName=PropertyGrid, Path=ActualWidth, ConverterParameter=0.6}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource DeleteContentItemButtonStyle}"/>
                            <ContentPresenter x:Name="ContentItem" DockPanel.Dock="Left"
                              Content="{Binding}" 
                              ContentTemplateSelector="{StaticResource PropSelector}"/>
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Left" Text="{Binding code}" TextWrapping="WrapWithOverflow" Padding="5" ClipToBounds="True" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type viewmodel:ComplexAttributeViewModel}" ItemsSource="{Binding attributeBindings}">
                <Expander Header="{Binding code}" IsExpanded="True" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding attributeBindings}" Margin="20,0,0,0"/>
                </Expander>
            </HierarchicalDataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid x:Name="PropertyGrid" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Background="#F0EEF1">
            <ComboBox 
                    DockPanel.Dock="Right" 
                    Style="{StaticResource ButtonLikeComboBox}"
                    ItemContainerStyle="{StaticResource ButtonLikeComboBoxItemStyle}"
                    ItemsSource="{Binding SelectedObject.attributeBindingsCatalogue, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}"
                    DisplayMemberPath="attribute">
                <i:Interaction.Behaviors>
                    <local:SelectionChangedBehavior Command="{Binding CreateAttributeCommand, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}" />
                </i:Interaction.Behaviors>
            </ComboBox>
            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedObject.code, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>

        <ItemsControl Grid.Row="1"
                   ItemsSource="{Binding SelectedObject.attributeBindings, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}"/>
    </Grid>
</UserControl>
