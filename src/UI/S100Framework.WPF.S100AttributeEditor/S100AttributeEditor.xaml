<UserControl x:Class="S100Framework.WPF.S100AttributeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:S100Framework.WPF"
             xmlns:localcontrols="clr-namespace:S100Framework.WPF.Controls"
             xmlns:converters="clr-namespace:S100Framework.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/S100Framework.WPF.S100AttributeEditor;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Grid.IsSharedSizeScope="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Background="#FFA58DB1">
                <ComboBox DockPanel.Dock="Right" 
                          Style="{StaticResource ButtonLikeComboBox}"
                          ItemsSource="{Binding AttributeBindings, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}"                          
                          DisplayMemberPath="attribute">
                </ComboBox>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}" FontWeight="Bold" />
            </DockPanel>

            <ItemsControl Grid.Row="1"
                   ItemsSource="{Binding PropertyValues, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}"
                   ItemTemplateSelector="{StaticResource ItemControlSelector}"/>
        </Grid>
    </StackPanel>
</UserControl>
