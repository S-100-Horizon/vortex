<UserControl x:Class="S100Framework.WPF.S100AttributeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:S100Framework.WPF"
             xmlns:converters="clr-namespace:S100Framework.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel Grid.IsSharedSizeScope="True">
        <local:PropertyGrid SelectedObject="{Binding SelectedObject, RelativeSource={RelativeSource AncestorType={x:Type local:S100AttributeEditor}}}"/>
    </StackPanel>
</UserControl>
